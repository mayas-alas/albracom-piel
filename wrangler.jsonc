{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albracom-piel",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
